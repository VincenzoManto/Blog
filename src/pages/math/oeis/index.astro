---
import Layout from '../../../layouts/Layout.astro';
import { getOEISDataFull } from '../../../lib/api';

const data = (await getOEISDataFull()).map(({ props }) => props);
const topCollaborators = new Set(data.reduce((acc: string[], { seq }) => {
  const authors = seq.author?.match(/_(.*?)_/g) || [];
  acc.push(...authors.filter((n: string) => n.trim() !== '_Vincenzo Manto_').map((n: string) => n.replace(/_/g, ' ')));
  return acc;
}, []));
const perc = (100 * (1 - 1 / (2.2 * Math.sqrt(data.length + 0.4)))).toFixed(2);
const first = data[0];
const last = data[data.length - 1];
---

<Layout title="Mathematics">
  <h2 style="margin-bottom: 2.5rem;">Integer Sequences (OEIS)</h2>
  <p style="color: var(--color-text-light); margin-bottom: 2rem;">Vincenzo Manto is the author of {data.length} integer sequences in the OEIS database.
  {data.length > 0 && <>
  His work has contributed to the field of integer sequences, ranging from <code>{first.custom?.name || first.seq?.name}</code> (A{first.seq.number}) to <code>{last.custom?.name || last.seq?.name}</code> (A{last.seq.number}).<br/>
  His most prolific partners include {[...topCollaborators].join(', ')}.<br/>
  These sequences have been cited by {data.reduce((acc: number, { seq }) => acc + (seq.xref?.length || 0), 0)} other sequences, making him a {perc}-percentile contributor.
  </>}
  </p>

  <div>
    {data.sort((a, b) => new Date(b.seq.created).getTime() - new Date(a.seq.created).getTime()).map(({seq,custom}) => (
      <div class="card">
        <h3 style="margin-bottom: 0.5rem;"><a href={`${import.meta.env.BASE_URL}math/oeis/A${seq.number}/`}>
		{seq.draft ? '[Draft] ' : ''}
		{custom?.name} A{seq.number}</a>: {seq.name}</h3>
        <p class="meta">Created: {new Date(seq.created).toLocaleDateString()} | Author: {seq.author.replace(/_/g, ' ')}</p>
        {seq.references ? (<p class="meta"><strong>Cited by:</strong> {seq.references} sequences</p>) : null}
      </div>
    ))}

  </div>
</Layout>
