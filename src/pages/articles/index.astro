---
import Layout from '../../layouts/Layout.astro';
import { getPapers } from '../../lib/api';
import { renderInlineMarkdown } from '../../lib/markdown';

const externalPapers = await getPapers();
// Fetch all markdown files in the pages/articles folder
const allArticles = Object.values(import.meta.glob('./*.mdx', { eager: true }));
allArticles.push(...externalPapers.map(paper => ({ url: paper.link, frontmatter: paper })));
// Sort by date if available
const sortedArticles = allArticles.sort((a, b) => {
    const dateA = new Date(a.frontmatter.date || 0);
    const dateB = new Date(b.frontmatter.date || 0);
    return dateB.getTime() - dateA.getTime();
});

// NOTE: this site is statically prerendered (output: 'static'), so a single
// build of this page is served regardless of query string. Filtering by
// ?search=<tag> therefore happens client-side (see <script> below), not here.
---

<Layout title="Papers & Articles">
	<h2>Papers & Articles</h2>
	<p>
	Here some of the papers and articles I think are worth mentioning. They cover a range of topics in mathematics, computer science, and related fields.
	I'm honored to have co-authored several papers with esteemed colleagues like {[...new Set(sortedArticles.map(article => article.frontmatter.author?.split(',') || []).flat())].filter(e => e.trim() !== 'Vincenzo Manto').join(', ')}.
	</p>

	<p class="active-filter" id="active-filter" hidden>
		Filtering by tag: <strong id="active-filter-tag"></strong>
		<a href="#" class="clear-filter" id="clear-filter">clear ✕</a>
	</p>

	<div style="margin-top: 2rem;" id="articles-list">
		{sortedArticles.length > 0 ? (
			sortedArticles.map((article) => (
				<div
					class="card"
					data-article-id={article.url}
					data-keywords={(article.frontmatter.keywords || []).map((k) => k.toLowerCase()).join('|')}
					data-default-starred={article.frontmatter.starred ? 'true' : 'false'}
				>
					<button type="button" class="star-toggle" data-article-id={article.url} aria-label="Toggle favorite" title="Toggle favorite">☆</button>
					<h3><a href={article.url}>{article.frontmatter.title}</a></h3>
					<div class="meta grid">
						<span>Date: {new Date(article.frontmatter.date).toLocaleDateString()}</span>
						<span>{article.frontmatter.author && `Author: ${article.frontmatter.author}`}</span>
						<span>{article.frontmatter.doi && `DOI: ${article.frontmatter.doi}`}</span>
					</div>
					{article.frontmatter.abstract && (
						<p set:html={renderInlineMarkdown(article.frontmatter.abstract)} />
					)}
					{article.frontmatter.keywords?.map((keyword) => (
						<a class="keyword" href={`?search=${encodeURIComponent(keyword)}`}>{keyword}</a>
					))}
				</div>
			))
		) : (
			<p>No articles found. Add MDX files to the src/pages/articles directory.</p>
		)}
	</div>
	<p id="no-match-message" hidden>No articles found matching this filter.</p>
</Layout>

<style>
	.active-filter {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.clear-filter {
		font-size: 0.85em;
	}
	.card {
		position: relative;
	}
	.star-toggle {
		position: absolute;
		top: 0;
		right: 0;
		background: none;
		border: none;
		cursor: pointer;
		font-size: 1.4rem;
		line-height: 1;
		color: var(--color-text-light);
		padding: 0.2rem;
	}
	.star-toggle.starred {
		color: #f5b700;
	}
	.card.starred {
		border-color: #f5b700;
	}
</style>

<script>
	// Star state = frontmatter `starred: true` (set in code, ships baked into the page)
	// overridden per-browser by manual clicks, stored as an override map in localStorage.
	const STORAGE_KEY = 'starredArticlesOverrides';

	function getOverrides(): Record<string, boolean> {
		try {
			return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
		} catch {
			return {};
		}
	}

	function setOverrides(overrides: Record<string, boolean>) {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(overrides));
	}

	function isStarred(card: HTMLElement, overrides: Record<string, boolean>): boolean {
		const id = card.dataset.articleId || '';
		if (id in overrides) return overrides[id];
		return card.dataset.defaultStarred === 'true';
	}

	function applyStarredState() {
		const overrides = getOverrides();
		const list = document.getElementById('articles-list');
		if (!list) return;

		document.querySelectorAll<HTMLButtonElement>('.star-toggle').forEach((button) => {
			const card = button.closest<HTMLElement>('.card');
			const starred = !!card && isStarred(card, overrides);
			button.textContent = starred ? '★' : '☆';
			button.classList.toggle('starred', starred);
			card?.classList.toggle('starred', starred);
		});

		const cards = Array.from(list.querySelectorAll<HTMLElement>('.card'));
		cards
			.sort((a, b) => Number(isStarred(b, overrides)) - Number(isStarred(a, overrides)))
			.forEach((card) => list.appendChild(card));
	}

	document.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement)?.closest<HTMLButtonElement>('.star-toggle');
		const card = button?.closest<HTMLElement>('.card');
		if (!button || !card || !card.dataset.articleId) return;

		const id = card.dataset.articleId;
		const overrides = getOverrides();
		overrides[id] = !isStarred(card, overrides);
		setOverrides(overrides);
		applyStarredState();
	});

	function applyTagFilter() {
		const tag = new URLSearchParams(window.location.search).get('search');
		const banner = document.getElementById('active-filter');
		const bannerTag = document.getElementById('active-filter-tag');
		const noMatch = document.getElementById('no-match-message');
		const cards = Array.from(document.querySelectorAll<HTMLElement>('#articles-list .card'));

		if (!tag) {
			banner?.setAttribute('hidden', '');
			cards.forEach((card) => card.removeAttribute('hidden'));
			noMatch?.setAttribute('hidden', '');
			return;
		}

		if (banner && bannerTag) {
			bannerTag.textContent = tag;
			banner.removeAttribute('hidden');
		}

		const needle = tag.toLowerCase();
		let anyVisible = false;
		cards.forEach((card) => {
			const keywords = (card.dataset.keywords || '').split('|');
			const matches = keywords.includes(needle);
			card.toggleAttribute('hidden', !matches);
			if (matches) anyVisible = true;
		});
		noMatch?.toggleAttribute('hidden', anyVisible);
	}

	document.getElementById('clear-filter')?.addEventListener('click', (event) => {
		event.preventDefault();
		window.location.href = window.location.pathname;
	});

	applyStarredState();
	applyTagFilter();
</script>
