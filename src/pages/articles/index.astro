---
import Layout from '../../layouts/Layout.astro';
import { getPapers } from '../../lib/api';
import { renderInlineMarkdown } from '../../lib/markdown';

const externalPapers = await getPapers();
// Fetch all markdown files in the pages/articles folder
const allArticles = Object.values(import.meta.glob('./*.mdx', { eager: true }));
allArticles.push(...externalPapers.map(paper => ({ url: paper.link, frontmatter: paper })));
// Sort by date if available
const sortedArticles = allArticles.sort((a, b) => {
    const dateA = new Date(a.frontmatter.date || 0);
    const dateB = new Date(b.frontmatter.date || 0);
    return dateB.getTime() - dateA.getTime();
});
---

<Layout title="Papers & Articles">
	<h2>Papers & Articles</h2>
	<p>
	Here some of the papers and articles I think are worth mentioning. They cover a range of topics in mathematics, computer science, and related fields. 
	I'm honored to have co-authored several papers with esteemed colleagues like {[...new Set(sortedArticles.map(article => article.frontmatter.author?.split(',') || []).flat())].filter(e => e.trim() !== 'Vincenzo Manto').join(', ')}.
	</p>
	
	<div style="margin-top: 2rem;">
		{sortedArticles.length > 0 ? (
			sortedArticles.map((article) => (
				<div class="card">
					<h3><a href={article.url}>{article.frontmatter.title}</a></h3>
					<div class="meta grid">
						<span>Date: {new Date(article.frontmatter.date).toLocaleDateString()}</span>
						<span>{article.frontmatter.author && `Author: ${article.frontmatter.author}`}</span>
						<span>{article.frontmatter.doi && `DOI: ${article.frontmatter.doi}`}</span>
					</div>
					{article.frontmatter.abstract && (
						<p set:html={renderInlineMarkdown(article.frontmatter.abstract)} />
					)}
					{article.frontmatter.keywords?.map((keyword) => (
						<span class="keyword">{keyword}</span>
					))}
				</div>
			))
		) : (
			<p>No articles found. Add MDX files to the src/pages/articles directory.</p>
		)}
	</div>
</Layout>
