---
import Layout from './Layout.astro';
const { frontmatter, file } = Astro.props;
import { renderInlineMarkdown } from '../lib/markdown';

const slug = file ? file.split(/[\\/]/).pop()?.replace(/\.mdx?$/, '') : undefined;
const doiId = frontmatter.doi ? String(frontmatter.doi).replace(/^.*doi\.org\//, '') : undefined;
const authors = frontmatter.author ? String(frontmatter.author).split(',').map((a: string) => a.trim()) : ['Vincenzo Manto'];
const pdfUrl = doiId && slug ? `${import.meta.env.BASE_URL}preprints/${slug}.pdf` : undefined;
---

<Layout title={frontmatter.title}>
	<Fragment slot="head">
		{doiId && (
			<>
				<meta name="citation_title" content={frontmatter.title} />
				{authors.map((a: string) => <meta name="citation_author" content={a} />)}
				{frontmatter.date && <meta name="citation_publication_date" content={new Date(frontmatter.date).toISOString().slice(0, 10)} />}
				<meta name="citation_doi" content={doiId} />
				{pdfUrl && <meta name="citation_pdf_url" content={new URL(pdfUrl, Astro.site).toString()} />}
				<meta name="citation_abstract_html_url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
				{frontmatter.keywords && frontmatter.keywords.map((k: string) => <meta name="citation_keyword" content={k} />)}
				{frontmatter.abstract && <meta name="description" content={frontmatter.abstract} />}
			</>
		)}
	</Fragment>
	<article>
	<table>
		<tr>
			<td><strong>Title:</strong></td>
			<td>{frontmatter.title}</td>
		</tr>
		<tr>
			<td><strong>Author:</strong></td>
			<td>{frontmatter.author || 'Vincenzo Manto'}</td>
		</tr>
		<tr>
			<td><strong>Date:</strong></td>
			<td><time>{new Date(frontmatter.date).toLocaleDateString()}</time></td>
		</tr>
		{frontmatter.link && (
			<tr>
			<td><strong>Link:</strong></td>
			<td><a href={frontmatter.link} target="_blank">{frontmatter.link}</a></td>
		</tr>
		)}
		{frontmatter.keywords && (
			<tr>
				<td><strong>Keywords:</strong></td>
				<td>{frontmatter.keywords.map((keyword) => (
					<span class="keyword">{keyword}</span>
				))}</td>
			</tr>
		)}
		{doiId && (
			<tr>
				<td><strong>DOI:</strong></td>
				<td><a href={`https://doi.org/${doiId}`} target="_blank">{doiId}</a></td>
			</tr>
		)}
		{pdfUrl && (
			<tr>
				<td><strong>Preprint PDF:</strong></td>
				<td><a href={pdfUrl} target="_blank">Download PDF</a></td>
			</tr>
		)}
	</table>
		<header style="text-align: center; margin-bottom: 2rem; border-bottom: none;">
			<h1 style="width: 100%;     text-align: center;margin-bottom: 40px;border-bottom: 2px solid #000;padding-bottom: 10px;" >{frontmatter.title}</h1>
			
		</header>
		
		{frontmatter.abstract && (
			<div class="paper-abstract">
				<strong>Abstract:</strong> 
						<p set:html={renderInlineMarkdown(frontmatter.abstract)} />
			</div>
		)}

		<div class="paper-layout">
            <slot />
        </div>
	</article>
</Layout>
